Instance: SsidlOrganizationDiagnosticEntity-2
InstanceOf: SsidlOrganizationDiagnosticEntity
Title: "Przykład: Podmiot diagnostyczny LABO"
Description: "Przykład podmiotu diagnostycznego wg SSIDL"
Usage: #example
* identifier.system = #urn:oid:2.16.840.1.113883.3.4424.2.3.1
* identifier.value = "000000001111"
* name = "LABO Sp. z o.o."
* contact.telecom[phone].system = #phone
* contact.telecom[phone].value = "+48 111 111 111"
* contact.telecom[email].system = #email
* contact.telecom[email].value = "fake@labo.com.pl"

